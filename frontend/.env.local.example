# frontend/.env.local — kopieer naar .env.local en vul in.

# ── Strapi backend ──────────────────────────────────────────────────────────
# URL van de Strapi-instantie. In dev: localhost:1337. In prod: live backend URL.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Read-only API token — aanmaken in Strapi admin → Instellingen → API Tokens.
STRAPI_API_TOKEN=

# ── Media (next/image remote hosts) ─────────────────────────────────────────
# Spaces CDN hostname (geen protocol), bijv. mijn-bucket.fra1.cdn.digitaloceanspaces.com
# Alleen nodig in prod. Leeg laten in dev.
NEXT_PUBLIC_MEDIA_HOST=

# ── Mapbox (routekaart) ─────────────────────────────────────────────────────
# Gratis account + token via https://mapbox.com → account → tokens
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── On-demand revalidation ──────────────────────────────────────────────────
REVALIDATE_SECRET=
