# ---- Strapi core (already generated in your real .env — do NOT commit real values) ----
HOST=0.0.0.0
PORT=1337
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ---- i18n ----
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=nl

# ---- Database toggle: "sqlite" (local) or "postgres" (live) ----
DATABASE_CLIENT=sqlite

# ---- Live Postgres (DigitalOcean) — use DISCRETE params, NOT a URL ----
# DO bakes ?sslmode=require into its connection string, which overrides Strapi's
# ssl settings and causes "self-signed certificate in certificate chain".
# Decomposing into separate params avoids that entirely. Leave DATABASE_URL unset.
# DATABASE_HOST=your-db-host.db.ondigitalocean.com
# DATABASE_PORT=25060
# DATABASE_NAME=defaultdb
# DATABASE_USERNAME=doadmin
# DATABASE_PASSWORD=
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ---- Media: DigitalOcean Spaces (S3-compatible) ----
# Leave ALL of these UNSET for local dev — Strapi falls back to local-disk uploads
# automatically (see config/plugins.ts). Set all six on the LIVE backend (and on
# DO App Platform as App-Level env vars, marked Encrypted for the secrets) to flip
# to Spaces for prod.
#
# ⚠️ ENDPOINT TRAP — must be the REGIONAL endpoint, WITHOUT the bucket:
#     ✅ https://fra1.digitaloceanspaces.com
#     ❌ https://my-bucket.fra1.digitaloceanspaces.com  (the "Origin Endpoint"
#        in DO's panel has the bucket baked in — using it double-prefixes and
#        breaks every upload)
# CDN should point at the CDN host (enable CDN on the Space — it ships disabled).
# DO_SPACE_ENDPOINT=https://<region>.digitaloceanspaces.com
# DO_SPACE_CDN=https://<bucket>.<region>.cdn.digitaloceanspaces.com
# DO_SPACE_REGION=fra1
# DO_SPACE_BUCKET=
# DO_SPACE_ACCESS_KEY=
# DO_SPACE_SECRET_KEY=
